# OBRIGATORIO e forte: minimo 32 caracteres, gere com
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# O servidor NAO SOBE se estiver vazio ou com valor padrao fraco.
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ADMIN_USER=admin
# OBRIGATORIA e forte: minimo 8 caracteres, letras + numeros, nao pode ser
# "admin123" nem outra senha comum. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(12))"
ADMIN_PASSWORD=

# OBRIGATORIO e numerico. O PIN protege acoes sensiveis na interface
# (ver clientes, enviar email em massa). Gere com:
#   python -c "import secrets; print(secrets.randbelow(10**8))"
CLIENTE_VIEW_PIN=

# Origens autorizadas a chamar a API. Para dev local, o padrao ja serve.
# Em producao, liste APENAS o dominio do seu front.
# CORS_ORIGINS=https://crm.seudominio.com

# Limite de tentativas de login por IP+usuario antes do bloqueio temporario
# MAX_TENTATIVAS_LOGIN=5
# JANELA_BLOQUEIO_MINUTOS=15

# ── Banco de dados ──────────────────────────────────────────────
# Fonte da verdade: SUPABASE. Preencha a URL de conexao do seu projeto
# em Settings > Database > Connection string (use o "URI" ou o pooler).
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# O codigo SEMPRE prioriza DATABASE_URL (ver get_db_connection em app.py).
# Se voce comentar esta linha, o servidor passa a usar o Postgres local
# abaixo. A variavel USE_LOCAL existe no .env antigo mas e IGNORADA pelo
# codigo - nao confie nela.
#
# Banco local (usado apenas se DATABASE_URL estiver comentado)
# DB_HOST=localhost
# DB_NAME=db_crm_freelancer
# DB_USER=postgres
# DB_PASSWORD=sua-senha

# Google OAuth (opcional - para login com Google)
# GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
